# LLM configuration for git-spec
LLM_PROVIDER=other
LLM_BASE_URL=https://litellm.data-light.ru/v1
OPENAI_API_KEY=your_vsellm_api_key_here
LLM_MODEL=openai/gpt-4o-mini

# Embeddings configuration for git-spec vector store
EMBEDDING_PROVIDER=other
EMBEDDING_BASE_URL=https://litellm.data-light.ru/v1
EMBEDDING_MODEL=text-embedding-3-small
