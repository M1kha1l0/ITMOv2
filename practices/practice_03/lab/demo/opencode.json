{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:4b",
  "small_model": "ollama/qwen3.5:4b",
  "default_agent": "test-runner",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B (local)",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        },
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "test-runner": {
      "description": "Test sessions with local Ollama model (read-only)",
      "mode": "primary",
      "model": "ollama/qwen3.5:4b",
      "prompt": "{file:./repo-system.txt}",
      "steps": 6,
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "ETHALONS.md": "deny", "./ETHALONS.md": "deny", "**/ETHALONS.md": "deny" },
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
