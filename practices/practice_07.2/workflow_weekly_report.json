    {
      "id": "aggregate-stats",
      "name": "Aggregate_Statistics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        480
      ],
      "parameters": {
        "jsCode": "// Aggregate and group statistics by type and by author\nconst prep = $('Prepare_Time_Window').first().json;\n\nfunction normalizeItems(nodeName) {\n  try {\n    const raw = $(nodeName).all().map(i => i.json);\n    let flat = [];\n    for (const r of raw) {\n      if (Array.isArray(r)) {\n        flat = flat.concat(r);\n      } else if (r && r.data && Array.isArray(r.data)) {\n        flat = flat.concat(r.data);\n      } else if (r && r.number) {\n        flat.push(r);\n      }\n    }\n    return flat.filter(item => !item.pull_request);\n  } catch (e) {\n    return [];\n  }\n}\n\nconst allIssues = normalizeItems('GitHub_All_Issues_Week');\nconst bugs = normalizeItems('GitHub_Open_Bugs');\nconst features = normalizeItems('GitHub_Open_Features');\nconst closed = normalizeItems('GitHub_Closed_Issues');\n\nconst issueMap = new Map();\nallIssues.forEach(iss => {\n  if (iss.number) issueMap.set(iss.number, iss);\n});\n\nlet bugsCount = bugs.length;\nlet featuresCount = features.length;\nlet tasksCount = 0;\nlet needsTriageCount = 0;\nlet otherCount = 0;\n\nfor (const [num, iss] of issueMap.entries()) {\n  const labelNames = (iss.labels || []).map(l => (typeof l === 'string' ? l : l.name || '').toLowerCase());\n  if (labelNames.includes('task')) {\n    tasksCount++;\n  } else if (labelNames.includes('needs-triage')) {\n    needsTriageCount++;\n  } else if (!labelNames.includes('bug') && !labelNames.includes('feature')) {\n    otherCount++;\n  }\n}\n\nconst totalCount = issueMap.size;\nconst closedCount = closed.length;\nconst openCount = totalCount - closedCount >= 0 ? totalCount - closedCount : 0;\n\nconst authorMap = {};\nfor (const [num, iss] of issueMap.entries()) {\n  const author = iss.user?.login || 'unknown';\n  authorMap[author] = (authorMap[author] || 0) + 1;\n}\n\nconst authorList = Object.entries(authorMap)\n  .map(([author, count]) => ({ author, count }))\n  .sort((a, b) => b.count - a.count);\n\nconst topAuthor = authorList.length > 0 ? `${authorList[0].author} (${authorList[0].count})` : 'None';\n\nreturn [{\n  json: {\n    week_date: prep.week_date,\n    repo_full_name: prep.repo_full_name,\n    total_issues: totalCount,\n    bugs_count: bugsCount,\n    features_count: featuresCount,\n    tasks_count: tasksCount,\n    needs_triage_count: needsTriageCount,\n    closed_count: closedCount,\n    open_count: openCount,\n    top_author: topAuthor,\n    authors: authorList,\n    sample_issues: Array.from(issueMap.values()).slice(0, 10).map(i => ({\n      number: i.number,\n      title: i.title,\n      author: i.user?.login,\n      state: i.state,\n      labels: (i.labels || []).map(l => typeof l === 'string' ? l : l.name)\n    }))\n  }\n}];"
      }
    },
