    {
      "id": "calc-deltas",
      "name": "Calculate_Weekly_Diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        480
      ],
      "parameters": {
        "jsCode": "// Calculate Week-over-Week Diff (Δ)\nconst current = $('Aggregate_Statistics').first().json;\nconst historyRows = $('Get_Previous_Week_Stats').all().map(i => i.json);\nconst prev = historyRows[0] || {};\n\nconst prevTotal = Number(prev.total_issues || 0);\nconst prevBugs = Number(prev.bugs_count || 0);\nconst prevFeatures = Number(prev.features_count || 0);\nconst prevTasks = Number(prev.tasks_count || 0);\nconst prevClosed = Number(prev.closed_count || 0);\n\nfunction formatDelta(currVal, prevVal) {\n  const diff = currVal - prevVal;\n  if (diff > 0) return `+${diff} (↑)`;\n  if (diff < 0) return `${diff} (↓)`;\n  return `0 (=)`;\n}\n\nconst diffTotal = formatDelta(current.total_issues, prevTotal);\nconst diffBugs = formatDelta(current.bugs_count, prevBugs);\nconst diffFeatures = formatDelta(current.features_count, prevFeatures);\nconst diffTasks = formatDelta(current.tasks_count, prevTasks);\nconst diffClosed = formatDelta(current.closed_count, prevClosed);\n\nconst prompt = `Ты — Staff/Principal системный архитектор и тимлид в бигтехе.\nСформируй краткий, экспертный аналитический комментарий недели («AI-комментарий недели») для еженедельного дайджеста команды разработки по GitHub Issues.\n\nМетрики текущей недели (${current.week_date}):\n- Всего Issues: ${current.total_issues} [Δ к прошлой неделе: ${diffTotal}]\n- Открытые баги: ${current.bugs_count} [Δ к прошлой неделе: ${diffBugs}]\n- Запросы фичей: ${current.features_count} [Δ к прошлой неделе: ${diffFeatures}]\n- Задачи/вопросы: ${current.tasks_count} [Δ к прошлой неделе: ${diffTasks}]\n- Закрыто Issues: ${current.closed_count} [Δ к прошлой неделе: ${diffClosed}]\n- Требуют триажа (needs-triage): ${current.needs_triage_count}\n- Топ контрибьютор: ${current.top_author}\n\nПравила:\n1. Пиши на русском языке, лаконично, структурированно (2-3 емких абзаца или маркированных пункта).\n2. Оцени динамику (дельта к прошлой неделе): тренд стабильности качества, нагрузку на саппорт и бэклог.\n3. Дай одну ключевую рекомендацию команде на следующий спринт.`;\n\nreturn [{\n  json: {\n    ...current,\n    prev_week_date: prev.week_date || \"N/A\",\n    prev_total: prevTotal,\n    prev_bugs: prevBugs,\n    prev_features: prevFeatures,\n    prev_tasks: prevTasks,\n    prev_closed: prevClosed,\n    diff_total: diffTotal,\n    diff_bugs: diffBugs,\n    diff_features: diffFeatures,\n    diff_tasks: diffTasks,\n    diff_closed: diffClosed,\n    ai_prompt: prompt\n  }\n}];"
      }
    },
