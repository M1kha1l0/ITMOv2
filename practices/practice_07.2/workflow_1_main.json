    {
      "id": "parse-issue",
      "name": "Parse_Issue_Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        400
      ],
      "parameters": {
        "jsCode": "// Extract and normalize issue payload\nconst payload = $json.body || $json;\nconst action = payload.action || \"opened\";\nconst issue = payload.issue || payload;\n\nif (action !== \"opened\" && action !== \"reopened\" && action !== \"created\") {\n  return [];\n}\n\nif (!issue || !issue.number) {\n  return [];\n}\n\nconst repo = payload.repository || {};\nconst repoFullName = repo.full_name || \"M1kha1l0/sample-python-project\";\nconst repoOwner = repo.owner?.login || \"M1kha1l0\";\nconst repoName = repo.name || \"sample-python-project\";\n\nreturn [{\n  json: {\n    issue_number: issue.number,\n    issue_id: String(issue.number),\n    title: issue.title || \"Untitled Issue\",\n    body: issue.body || \"\",\n    author: issue.user?.login || \"unknown\",\n    author_association: issue.author_association || \"NONE\",\n    action: action,\n    repo_full_name: repoFullName,\n    repo_owner: repoOwner,\n    repo_name: repoName,\n    created_at: issue.created_at || new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "check-dedup",
      "name": "Check_Deduplication",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        560,
        400
      ],
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "SEQUuLjOXwZCNEJe"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "issue_id",
              "keyValue": "={{ $json.issue_id }}"
            }
          ]
        },
        "matchType": "allConditions",
        "operation": "rowNotExists"
      }
    },
