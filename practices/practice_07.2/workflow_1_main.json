    {
      "id": "decision-logic",
      "name": "Triage_Decision_Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        400
      ],
      "parameters": {
        "jsCode": "const issueData = $('Parse_Issue_Payload').first().json;\nconst classification = $json;\n\nconst type = (classification.type || \"unknown\").toLowerCase().trim();\nconst confidence = Number(classification.confidence || 0);\nconst reasoning = classification.reasoning || \"\";\n\n// Criterion 2: If confidence < 0.8 or type is unknown -> needs-triage\nlet branch = type;\nif (confidence < 0.8 || ![\"bug\", \"task\", \"feature\"].includes(type)) {\n  branch = \"needs-triage\";\n}\n\nlet labelToApply = branch;\nlet commentBody = null;\n\nif (branch === \"bug\") {\n  commentBody = `### 🤖 AI Issue Assistant: Баг-репорт принят\\n` +\n    `> 🏷️ **Тип:** \\`bug\\`\\n` +\n    `> 📊 **Уверенность:** \\`${Math.round(confidence * 100)}%\\`\\n` +\n    `> 📝 **Анализ:** ${reasoning}\\n\\n` +\n    `Спасибо за баг-репорт! Команда разработки уже оповещена и приступит к анализу проблемы.`;\n} else if (branch === \"feature\") {\n  commentBody = `### 🤖 AI Issue Assistant: Запрос фичи зарегистрирован\\n` +\n    `> 🏷️ **Тип:** \\`feature\\`\\n` +\n    `> 📊 **Уверенность:** \\`${Math.round(confidence * 100)}%\\`\\n` +\n    `> 📝 **Анализ:** ${reasoning}\\n\\n` +\n    `Спасибо за предложение новой функциональности! Задача добавлена в бэклог для оценки продуктовой ценности.`;\n} else if (branch === \"task\") {\n  commentBody = `### 🤖 AI Issue Assistant: Задача / вопрос зарегистрирован\\n` +\n    `> 🏷️ **Тип:** \\`task\\`\\n` +\n    `> 📊 **Уверенность:** \\`${Math.round(confidence * 100)}%\\`\\n` +\n    `> 📝 **Анализ:** ${reasoning}\\n\\n` +\n    `Спасибо за обращение! Вопрос принят в работу мейнтейнерами.`;\n} else {\n  // needs-triage: STRICT REQUIREMENT - NO COMMENT POSTED\n  commentBody = null;\n}\n\nconst isFirstTime = (issueData.author_association === \"NONE\");\n\nreturn [{\n  json: {\n    issue_number: issueData.issue_number,\n    issue_id: issueData.issue_id,\n    title: issueData.title,\n    body: issueData.body,\n    author: issueData.author,\n    author_association: issueData.author_association,\n    repo_full_name: issueData.repo_full_name,\n    type: type,\n    confidence: confidence,\n    reasoning: reasoning,\n    branch: branch,\n    label: labelToApply,\n    comment: commentBody,\n    is_first_time: isFirstTime,\n    created_at: issueData.created_at\n  }\n}];"
      }
    },
