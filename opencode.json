{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills",
      "practices/practice_05/.opencode/skills"
    ]
  },
  "plugin": [
    "opencode-gemini-auth",
    "./practices/practice_05/.opencode/plugins/practice04-check/index.js"
  ],
  "mcp": {
    "practice04": {
      "type": "local",
      "command": ["node", "/storage/ssd/Documents/education/itmo/vibecoding/ITMOv2/practices/practice_05/.opencode/mcp/server.js"],
      "enabled": true,
      "environment": {
        "PY_BIN": ".venv/bin/python",
        "MCP_PORT": "8777"
      }
    }
  }
}
